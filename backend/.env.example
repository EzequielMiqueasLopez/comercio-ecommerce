# Servidor
PORT=4000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=comercio
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# Seguridad
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# Correo (notificaciones de pedido)
# Si dejas estos 3 en blanco, el sistema crea automáticamente una cuenta
# de prueba de Ethereal y muestra la URL de vista previa en la consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Comercio Electrónico" <no-reply@comercio.local>
ADMIN_EMAIL=admin@comercio.local

# Datos bancarios de ejemplo (se muestran en el correo al cliente)
BANK_NAME=Banco Ejemplo
BANK_HOLDER=Comercio Electronico SA de CV
BANK_CLABE=012345678901234567
